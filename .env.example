# Copy to .env.local for local builds. In Vercel, set these for Production and Preview.
# The repository holding profile.json, as owner/name. It is always read at the `main` branch.
PROFILE_STORE_REPO=example-owner/profile-store
# Fine-grained token: that repository only, Contents read-only, with an expiry.
PROFILE_STORE_TOKEN=
# Optional: URL of the chat app, shown first in the header links. Omitted when unset.
CHAT_URL=https://chat.example.com/
